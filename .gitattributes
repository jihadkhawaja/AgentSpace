# Normalize text to LF across platforms.
* text=auto eol=lf
*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.sln text
*.slnx text
*.sh text
*.ps1 text

# Windows command scripts use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Compiled files, packages, and other binary assets.
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
